{
  "log": { "level": "info", "timestamp": true },
  "experimental": { "cache_file": { "enabled": true, "path": "${CACHE_FILE}" } },
  "dns": {
    "servers": [
      { "type": "https", "tag": "dns-cn", "server": "${DNS_CN}", "path": "/dns-query", "detour": "direct" },
      { "type": "https", "tag": "dns-remote", "server": "${DNS_REMOTE}", "path": "/dns-query", "detour": "${PROXY_TAG}" }
    ],
    "rules": [
      { "rule_set": "geosite-cn", "server": "dns-cn" },
      { "server": "dns-remote" }
    ],
    "final": "dns-remote"
  },
  "http_clients": [
    { "tag": "rule-set-download", "detour": "${PROXY_TAG}" }
  ],
  "inbounds": [
__INBOUNDS__
  ],
  "outbounds": [
__OUTBOUNDS__
  ],
  "route": {
    "rule_set": [
__RULESETS__
    ],
    "rules": [
__RULES__
    ],
    "final": "${PROXY_TAG}",
    "default_http_client": "rule-set-download",
__ROUTE_DEFAULT_IFACE__
    "auto_detect_interface": ${AUTO_DETECT_INTERFACE},
    "default_domain_resolver": { "server": "dns-remote" }
  }
}
